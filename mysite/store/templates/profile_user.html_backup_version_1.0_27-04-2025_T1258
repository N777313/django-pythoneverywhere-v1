<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Мой Mini App</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
</head>
<body>
    <h1>Добро пожаловать!</h1>

    <button id="sendInitData">Отправить данные</button>

    <script>
        const initData = window.Telegram.WebApp.initData;

        document.getElementById('sendInitData').addEventListener('click', function () {
            fetch('/api/save-user/', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    initData: initData
                })
            })
            .then(response => response.json())
            .then(data => {
                console.log('Ответ сервера:', data);
                if (data.user_id) {
                    alert('Ваш Telegram ID: ' + data.user_id);
                }
            })
            .catch(error => console.error('Ошибка:', error));
        });
    </script>
</body>
</html>
