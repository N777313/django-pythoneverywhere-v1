<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Мой Mini App</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
</head>
<body>
<!-- 27-04-2025 version 2.0 -->
<h1>Ассалаумагалейкум, Version 2.0! </h1>


<script>
    const initData = window.Telegram.WebApp.initData;
    const initDataUnsafe = window.Telegram.WebApp.initDataUnsafe;

    if (initData) {
        fetch('/api/save-user/', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                initData: initData
            })
        })
        .then(response => response.json())
        .then(data => {
            console.log('Ответ сервера:', data);
            if (data.user_id) {
                alert('Ваш Telegram ID: ' + data.user_id);
            }
        })
        .catch(error => console.error('Ошибка:', error));
    } else {
        console.error('initData отсутствует. Страница открыта вне Telegram?');
    }
</script>

</body>
</html>
