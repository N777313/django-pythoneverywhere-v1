{% extends 'base.html' %}

{% block content %}

<div class="container">

    <div class="card mb-3">
  <div class="row g-0">
    <div class="col-md-4">
      <img src="{{ product.urlpath }}" class="img-fluid rounded-start" alt="...">
    </div>
    <div class="col-md-8">
      <div class="card-body">
          <h1 class="Typography Typography__XL Typography__XL_Bold">{{ product.name }}</h1>
          <p class="Typography Description_text__27B77 Description_leftText__v_3LD Description_smallText__1Nrsn Typography__L">Description: <span>{{ product.description }}<span></p>
        {% if product.is_sale %}
            <div class="d-flex justify small text-warning mb-2">
            <div class="bi-star-fill"></div>
            <div class="bi-star-fill"></div>
            <div class="bi-star-fill"></div>
            <div class="bi-star-fill"></div>
            <div class="bi-star-fill"></div>
            </div>
                <!-- Product price-->
                <strike> ${{ product.price }} </strike>
                &nbsp;
                ${{ product.sale_price }}
                <br/> ID: {{ product.id }}
        {% else %}
            {{ product.price }} ₸
            <br/> ID: {{ product.id }}
        {% endif%}
        <br/><br/><br/>

        <div>
            <a href="{% url 'home' %}" class="btn btn-secondary w-auto">Home</a>
            <button type="button" value="{{ product.id }}" class="btn btn-secondary" id="add-cart">Add To Cart</button>
        </div>
      </div>
    </div>
  </div>
</div>

</div>
<br/><br/><br/><br/><br/><br/><br/>
<script>
    // check if button pressed
    $(document).on('click', '#add-cart', function(e){
        e.preventDefault();
        $.ajax({
           type: 'POST',
           url: '{% url 'cart_add' %}',
           data: {
               product_id: $('#add-cart').val(),
               csrfmiddlewaretoken: '{{ csrf_token }}',
               action: 'post'
           },
           success: function(json){
               //console.log(json)
               document.getElementById("cart_quantity").textContent = json.qty
           },
           error: function(xhr, errmsg, err){

           },

        });
    })

</script>
{% endblock %}